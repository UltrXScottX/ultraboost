{
  "schemaVersion": 1,
  "id": "ultraboost",
  "version": "${version}",
  "name": "UltraBoost",
  "description": "A lightweight FPS and smoothness booster for Fabric 1.21.6 with culling, particle limiting, render tuning, and smart optimization.",
  "authors": [
    "UltrXScottX"
  ],
  "contact": {
    "homepage": "https://github.com/UltrXScottX/ultraboost",
    "sources": "https://github.com/UltrXScottX/ultraboost"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.ultraxscott.ultraboost.UltraBoostClient"
    ],
    "modmenu": [
      "com.ultraxscott.ultraboost.config.UltraBoostModMenu"
    ]
  },
  "mixins": [
    "ultraboost.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.6",
    "java": ">=21",
    "fabric-api": "*"
  },
  "recommends": {
    "cloth-config": "*",
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "badges": [ "Client" ],
      "parent": "fabric"
    }
  }
}
